<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"] - ShopApp.MVC</title>
    <partial name="~/Views/Shared/Partials/Layout/_HeadPartial.cshtml" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <vc:navbar />

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
   
    <partial name="~/Views/Shared/Partials/Layout/_ScriptsPartial.cshtml" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
