@using ShopApp.MVC.Data.Entities
@model List<Category>


<a asp-action="Create" class="btn btn-success mb-2">Yeni kategori ekle</a>
<table class="table table-striped table-hover">

    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>İşlemler</th>
        </tr>
    </thead>


    <tbody>
        @foreach (Category category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-warning">Düzenle</a>
                    
                    <a data-bs-toggle="modal" data-bs-target="#categoryDeleteModal-@category.Id" class="btn btn-danger">Sil</a>

                    <!-- Modal -->
                    <div class="modal fade" id="categoryDeleteModal-@category.Id" tabindex="-1" aria-labelledby="categoryDeleteModalLabel-@category.Id" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h1 class="modal-title fs-5" id="categoryDeleteModalLabel-@category.Id">Uyarı!</h1>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <b>@category.Name</b> kategorisini silmek istediğinize emin misiniz?


                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-danger">Sil</a>
                                </div>
                            </div>
                        </div>
                    </div>


                </td>
            </tr>
        }
    </tbody>
</table>




