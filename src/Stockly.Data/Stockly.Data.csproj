<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <!-- SQLite runs the public demo (see render.yaml). SourceGear.sqlite3 ships a patched native SQLite (3.50.4),
         which replaces the one SQLitePCLRaw.lib.e_sqlite3 2.1.11 bundles; NuGet still reports that package. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
    <!-- Microsoft.Data.SqlClient still pulls a version with known advisories. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- The native SQLite actually loaded is SourceGear.sqlite3's patched build (above). -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>
