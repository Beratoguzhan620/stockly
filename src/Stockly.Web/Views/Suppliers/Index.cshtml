@model List<Stockly.Application.Suppliers.SupplierRow>
@{
    ViewData["Title"] = "Tedarikçiler";
}

<partial name="Partials/_ViewMessages" />

<div class="page-header">
    <div>
        <h1>Tedarikçiler</h1>
        <p>Ürünlerin geldiği firmalar. Pasife alınan tedarikçi yeni ürünlerde seçilemez, eski kayıtlar korunur.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i>Yeni tedarikçi</a>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <partial name="Partials/_EmptyState" model="@(("Henüz tedarikçi yok", "Ürünlerinizi aldığınız firmaları ekleyin.", "bi-truck"))" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Firma</th>
                        <th>İletişim</th>
                        <th class="num">Ürün</th>
                        <th class="num">Kritik</th>
                        <th><span class="visually-hidden">İşlemler</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr class="@(s.IsActive ? null : "row-muted")">
                            <td>
                                <span class="fw-medium">@s.Name</span>
                                @if (!s.IsActive) { <span class="badge badge-neutral ms-1">Pasif</span> }
                            </td>
                            <td class="small">
                                @if (s.ContactName is not null) { <span class="d-block">@s.ContactName</span> }
                                @if (s.Phone is not null) { <a class="d-block text-muted" href="tel:@s.Phone.Replace(" ", "")">@s.Phone</a> }
                                @if (s.Email is not null) { <a class="d-block text-muted" href="mailto:@s.Email">@s.Email</a> }
                            </td>
                            <td class="num">
                                @if (s.ProductCount > 0)
                                {
                                    <a asp-controller="Products" asp-action="Index" asp-route-supplierId="@s.Id">@s.ProductCount</a>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="num">
                                @if (s.CriticalCount > 0)
                                {
                                    <a class="badge badge-warning" asp-controller="Products" asp-action="Index" asp-route-supplierId="@s.Id" asp-route-stock="Critical">@s.CriticalCount</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@s.Id">Düzenle</a>
                                <form class="d-inline" method="post" asp-action="SetActive" asp-route-id="@s.Id">
                                    <input type="hidden" name="active" value="@(s.IsActive ? "false" : "true")" />
                                    <button class="btn btn-ghost btn-sm" type="submit">@(s.IsActive ? "Pasife al" : "Aktif et")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
