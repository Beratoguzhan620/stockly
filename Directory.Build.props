<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11 (through Microsoft.EntityFrameworkCore.Sqlite) is reported for the SQLite it
         bundles. The native SQLite actually loaded comes from SourceGear.sqlite3 in Stockly.Data, a build with the fix;
         a test checks the version at run time. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
    <!-- Leaves out the bundled (unpatched) native SQLite, so the patched one from SourceGear.sqlite3 is the only one
         copied next to the app and loaded. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.11" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
</Project>
